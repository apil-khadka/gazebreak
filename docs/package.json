{
  "name": "@gazebreak/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GazeBreak product documentation and release website",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sync:releases": "node scripts/sync-releases.mjs",
    "build": "npm run sync:releases && vite build",
    "build:offline": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": { "vite": "^8.3.1" }
}
